
#!/usr/bin/env bash

# Fuzzel power menu for Sway

FUZZEL_CONFIG="$HOME/.config/sway/fuzzel/fuzzel.ini"
SCRIPTS="$HOME/.config/sway/scripts"

# Display power menu
chosen=$(
    printf '%s\n' \
        "  Cancel" \
        "󰖔  Screen Off" \
        "󰍃  Logout" \
        "  Shutdown" \
        "󰜉  Reboot" |
    fuzzel --dmenu \
        --prompt="Power Menu: " \
        --config="$FUZZEL_CONFIG"
)

# Handle selection
case "$chosen" in
    *"Screen Off")
        "$SCRIPTS/screen-off"
        ;;
    *"Logout")
        swaymsg exit
        ;;
    *"Shutdown")
        systemctl poweroff
        ;;
    *"Reboot")
        systemctl reboot
        ;;
    *)
        exit 0
        ;;
esac
